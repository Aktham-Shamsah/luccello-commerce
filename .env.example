# Development only. For the Ubuntu Docker stack, use .env.docker.example.
NODE_ENV=development
APP_ENV=local
STORE_DOMAIN=http://localhost:3000
ADMIN_DOMAIN=http://localhost:3001
API_DOMAIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Set your own different, strong secrets before authenticating.
ADMIN_LOCAL_KEY=CHANGE_ME_GENERATE_32_RANDOM_BYTES
ADMIN_PASSWORD=CHANGE_ME_GENERATE_32_RANDOM_BYTES
ADMIN_SESSION_SECRET=CHANGE_ME_GENERATE_32_RANDOM_BYTES
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_HASH_SALT=CHANGE_ME_GENERATE_32_RANDOM_BYTES
DATABASE_URL=postgres://postgres:postgres@localhost:5432/luccello
MOCK_PAYMENTS_ENABLED=false
MOCK_SHIPPING_ENABLED=true
GIT_SHA=local
VERSION=0.2.0-local
WHATSAPP_CONTACT=
