# Copy to .env and replace all CHANGE_ME placeholders with independent random secrets.
# Shell: openssl rand -hex 32
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
ADMIN_LOCAL_KEY=CHANGE_ME_BACKEND_PRIVATE_KEY
ADMIN_PASSWORD=CHANGE_ME_ADMIN_LOGIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_SIGNING_SECRET_AT_LEAST_32_CHARACTERS
SESSION_HASH_SALT=CHANGE_ME_SESSION_HASH_SALT
DATABASE_URL=postgres://postgres:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/luccello
NEXT_PUBLIC_API_URL=/backend
NODE_ENV=production
APP_ENV=local
STORE_DOMAIN=http://localhost:3000
ADMIN_DOMAIN=http://localhost:3001
API_DOMAIN=http://api:4000
GIT_SHA=docker
VERSION=0.2.0-docker
